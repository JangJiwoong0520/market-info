      "expect": {"ok": true, "riskPerShare": 500, "unit": 500000, "qtyRisk": 1000, "qtyMax": 1000, "capped": false, "qty": 1000, "cost": 10000000, "weight": 20, "actualRisk": 500000, "errors": [], "warnings": [],
